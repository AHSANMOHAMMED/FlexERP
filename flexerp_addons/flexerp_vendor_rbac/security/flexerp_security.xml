<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_flexerp">
        <field name="name">FlexERP</field>
        <field name="sequence">95</field>
        <field name="category_id" ref="base.module_category_administration"/>
    </record>

    <record id="group_platform_super_admin" model="res.groups">
        <field name="name">Platform Super Admin</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_flexerp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="comment">Full FlexERP platform control across all vendor slots.</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_vendor_admin" model="res.groups">
        <field name="name">Vendor Admin</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_flexerp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('point_of_sale.group_pos_manager')), (4, ref('stock.group_stock_user')), (4, ref('sales_team.group_sale_salesman')), (4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Manages a single vendor company slot (staff, stock, POS, sales).</field>
    </record>

    <record id="group_vendor_cashier" model="res.groups">
        <field name="name">Vendor Cashier</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_flexerp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('point_of_sale.group_pos_user'))]"/>
        <field name="comment">POS cashier scoped to one vendor company slot only.</field>
    </record>
</odoo>
