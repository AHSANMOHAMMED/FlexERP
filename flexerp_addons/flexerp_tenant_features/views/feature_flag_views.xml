<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_flexerp_feature_flag_list" model="ir.ui.view">
        <field name="name">flexerp.feature.flag.list</field>
        <field name="model">flexerp.feature.flag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="company_id"/>
                <field name="vendor_code"/>
                <field name="key"/>
                <field name="enabled"/>
            </list>
        </field>
    </record>

    <record id="action_flexerp_feature_flag" model="ir.actions.act_window">
        <field name="name">Mobile Feature Flags</field>
        <field name="res_model">flexerp.feature.flag</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_flexerp_root"
              name="FlexERP"
              parent="base.menu_administration"
              sequence="90"/>
    <menuitem id="menu_flexerp_feature_flags"
              name="Feature Flags"
              parent="menu_flexerp_root"
              action="action_flexerp_feature_flag"
              sequence="10"/>
</odoo>
