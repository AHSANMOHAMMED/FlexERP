    <record id="flexerp_wa_provider" model="ir.config_parameter">
        <field name="key">flexerp.whatsapp.provider</field>
        <field name="value">meta</field>
    </record>
    <record id="flexerp_wa_endpoint" model="ir.config_parameter">
        <field name="key">flexerp.whatsapp.endpoint</field>
